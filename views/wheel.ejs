<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Колесо Фортуны</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Roboto", sans-serif;
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        min-height: 100vh;
        overflow: hidden;
        position: relative;
      }

      /* Animated background stars */
      .stars {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: hidden;
        z-index: 0;
      }

      .star {
        position: absolute;
        width: 2px;
        height: 2px;
        background: white;
        border-radius: 50%;
        animation: twinkle 2s infinite;
      }

      @keyframes twinkle {
        0%, 100% { opacity: 0.3; }
        50% { opacity: 1; }
      }

      /* Header */
      .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        z-index: 100;
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(10px);
      }

      .user-info {
        text-align: left;
      }

      .username {
        color: #ffd700;
        font-weight: bold;
        font-size: 16px;
      }

      .balance {
        color: #7cfc00;
        font-size: 18px;
        font-weight: bold;
        display: flex;
        align-items: center;
        gap: 5px;
      }

      .back-btn {
        color: white;
        text-decoration: none;
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        font-size: 14px;
        transition: all 0.3s ease;
      }

      .back-btn:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      /* Main container */
      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 80px 20px 20px;
        position: relative;
        z-index: 1;
      }

      /* Wheel container */
      .wheel-container {
        position: relative;
        width: 320px;
        height: 320px;
        margin-bottom: 30px;
      }

      /* Pointer */
      .pointer {
        position: absolute;
        top: -25px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        font-size: 40px;
        filter: drop-shadow(0 4px 6px rgba(0, 0, 0, 0.5));
        animation: pointerBounce 0.5s ease-in-out infinite alternate;
      }

      @keyframes pointerBounce {
        from { transform: translateX(-50%) translateY(0); }
        to { transform: translateX(-50%) translateY(5px); }
      }

      /* Wheel */
      .wheel {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        position: relative;
        box-shadow: 
          0 0 0 8px #2c3e50,
          0 0 0 12px #ffd700,
          0 0 0 16px #2c3e50,
          0 0 40px rgba(255, 215, 0, 0.3),
          inset 0 0 30px rgba(0, 0, 0, 0.3);
        transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
        overflow: hidden;
      }

      .wheel.spinning {
        transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
      }

      /* Wheel sectors using conic-gradient */
      .wheel-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        position: relative;
      }

      .sector {
        position: absolute;
        width: 50%;
        height: 50%;
        top: 0;
        right: 0;
        transform-origin: bottom left;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }

      .sector-content {
        position: absolute;
        transform: rotate(22.5deg);
        color: white;
        font-weight: bold;
        font-size: 14px;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
        top: 35%;
        left: 15%;
      }

      .sector-content.jackpot {
        font-size: 11px;
        color: #1a1a2e;
        text-shadow: none;
        font-family: "Press Start 2P", cursive;
      }

      /* Center button */
      .wheel-center {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 60px;
        height: 60px;
        background: linear-gradient(145deg, #ffd700, #ffaa00);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #1a1a2e;
        font-size: 12px;
        box-shadow: 
          0 4px 15px rgba(255, 215, 0, 0.4),
          inset 0 2px 5px rgba(255, 255, 255, 0.3);
        z-index: 5;
      }

      /* Spin button */
      .spin-btn {
        background: linear-gradient(135deg, #ff4081, #ff6b6b, #ff4081);
        background-size: 200% 200%;
        animation: gradientShift 3s ease infinite;
        color: white;
        border: none;
        padding: 18px 50px;
        font-size: 22px;
        font-weight: bold;
        border-radius: 50px;
        cursor: pointer;
        box-shadow: 
          0 6px 20px rgba(255, 64, 129, 0.4),
          0 0 40px rgba(255, 64, 129, 0.2);
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      @keyframes gradientShift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
      }

      .spin-btn:hover:not(:disabled) {
        transform: scale(1.05);
        box-shadow: 
          0 8px 30px rgba(255, 64, 129, 0.5),
          0 0 60px rgba(255, 64, 129, 0.3);
      }

      .spin-btn:active:not(:disabled) {
        transform: scale(0.98);
      }

      .spin-btn:disabled {
        background: #555;
        cursor: not-allowed;
        animation: none;
        box-shadow: none;
      }

      /* Spins info */
      .spins-info {
        margin-top: 20px;
        text-align: center;
        color: white;
      }

      .spins-count {
        font-size: 20px;
        font-weight: bold;
        color: #ffd700;
      }

      .spins-label {
        font-size: 14px;
        color: #aaa;
        margin-top: 5px;
      }

      .timer {
        margin-top: 15px;
        font-size: 16px;
        color: #ff6b6b;
        font-family: "Press Start 2P", cursive;
      }

      .timer-label {
        font-size: 12px;
        color: #888;
        margin-top: 5px;
        font-family: "Roboto", sans-serif;
      }

      /* Prize popup */
      .prize-popup {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.8);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(5px);
      }

      .prize-popup.show {
        display: flex;
        animation: fadeIn 0.3s ease;
      }

      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }

      .prize-content {
        background: linear-gradient(145deg, #2c3e50, #1a1a2e);
        padding: 40px;
        border-radius: 20px;
        text-align: center;
        box-shadow: 
          0 20px 60px rgba(0, 0, 0, 0.5),
          0 0 0 3px #ffd700;
        animation: popIn 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        max-width: 90%;
      }

      @keyframes popIn {
        from { transform: scale(0.5); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      .prize-title {
        color: #ffd700;
        font-size: 24px;
        margin-bottom: 20px;
      }

      .prize-amount {
        font-size: 48px;
        font-weight: bold;
        color: #7cfc00;
        margin: 20px 0;
        text-shadow: 0 0 20px rgba(124, 252, 0, 0.5);
      }

      .prize-amount.jackpot {
        color: #ffd700;
        font-size: 36px;
        animation: jackpotPulse 0.5s ease infinite alternate;
      }

      @keyframes jackpotPulse {
        from { transform: scale(1); text-shadow: 0 0 20px rgba(255, 215, 0, 0.5); }
        to { transform: scale(1.1); text-shadow: 0 0 40px rgba(255, 215, 0, 0.8); }
      }

      .prize-close {
        background: #ff4081;
        color: white;
        border: none;
        padding: 12px 40px;
        font-size: 16px;
        border-radius: 30px;
        cursor: pointer;
        margin-top: 20px;
        transition: all 0.3s ease;
      }

      .prize-close:hover {
        background: #ff6b6b;
        transform: scale(1.05);
      }

      /* Confetti */
      .confetti {
        position: fixed;
        pointer-events: none;
        z-index: 1001;
      }

      .confetti-piece {
        position: absolute;
        width: 10px;
        height: 10px;
        opacity: 0;
      }

      /* No spins message */
      .no-spins-msg {
        color: #ff6b6b;
        font-size: 14px;
        margin-top: 10px;
      }
    </style>
  </head>
  <body>
    <!-- Animated stars background -->
    <div class="stars" id="stars"></div>

    <!-- Header -->
    <div class="header">
      <div class="user-info">
        <div class="username"><%= username %></div>
        <div class="balance" id="balance">🪙 <span id="balanceValue"><%= spinStatus.balance %></span> coins</div>
      </div>
      <a href="/play?username=<%= username %>&cointrust=<%= spinStatus.balance %>" class="back-btn">← Назад</a>
    </div>

    <!-- Main container -->
    <div class="container">
      <!-- Wheel -->
      <div class="wheel-container">
        <div class="pointer">▼</div>
        <div class="wheel" id="wheel">
          <div class="wheel-inner" id="wheelInner"></div>
          <div class="wheel-center">SPIN</div>
        </div>
      </div>

      <!-- Spin button -->
      <button class="spin-btn" id="spinBtn" <%= spinStatus.spinsRemaining <= 0 ? 'disabled' : '' %>>
        🎰 Крутить!
      </button>

      <!-- Spins info -->
      <div class="spins-info">
        <div class="spins-count"><span id="spinsRemaining"><%= spinStatus.spinsRemaining %></span> / 3</div>
        <div class="spins-label">бесплатных вращений</div>
        <div class="timer" id="timer" style="display: none;">--:--:--</div>
        <div class="timer-label" id="timerLabel" style="display: none;">до следующего спина</div>
      </div>
    </div>

    <!-- Prize popup -->
    <div class="prize-popup" id="prizePopup">
      <div class="prize-content">
        <div class="prize-title">🎉 Поздравляем!</div>
        <div class="prize-amount" id="prizeAmount">+100</div>
        <div style="color: #aaa;">монет добавлено к балансу</div>
        <button class="prize-close" id="prizeClose">Отлично!</button>
      </div>
    </div>

    <script>
      // Game data
      const userId = '<%= userId %>';
      const prizes = <%- prizes %>;
      let spinsRemaining = <%= spinStatus.spinsRemaining %>;
      let nextSpinAvailable = <%= spinStatus.nextSpinAvailable ? `new Date("${spinStatus.nextSpinAvailable}")` : 'null' %>;
      let isSpinning = false;
      let currentRotation = 0;

      // DOM elements
      const wheel = document.getElementById('wheel');
      const wheelInner = document.getElementById('wheelInner');
      const spinBtn = document.getElementById('spinBtn');
      const spinsRemainingEl = document.getElementById('spinsRemaining');
      const balanceValueEl = document.getElementById('balanceValue');
      const timerEl = document.getElementById('timer');
      const timerLabelEl = document.getElementById('timerLabel');
      const prizePopup = document.getElementById('prizePopup');
      const prizeAmount = document.getElementById('prizeAmount');
      const prizeClose = document.getElementById('prizeClose');

      // Create stars
      function createStars() {
        const starsContainer = document.getElementById('stars');
        for (let i = 0; i < 100; i++) {
          const star = document.createElement('div');
          star.className = 'star';
          star.style.left = Math.random() * 100 + '%';
          star.style.top = Math.random() * 100 + '%';
          star.style.animationDelay = Math.random() * 2 + 's';
          star.style.width = (Math.random() * 2 + 1) + 'px';
          star.style.height = star.style.width;
          starsContainer.appendChild(star);
        }
      }

      // Create wheel sectors
      function createWheel() {
        const sectorAngle = 360 / prizes.length;
        
        prizes.forEach((prize, index) => {
          const sector = document.createElement('div');
          sector.className = 'sector';
          sector.style.background = prize.color;
          sector.style.transform = `rotate(${index * sectorAngle}deg) skewY(-${90 - sectorAngle}deg)`;
          
          const content = document.createElement('div');
          content.className = 'sector-content' + (prize.value === 5000 ? ' jackpot' : '');
          content.textContent = prize.label;
          sector.appendChild(content);
          
          wheelInner.appendChild(sector);
        });
      }

      // Spin the wheel
      async function spin() {
        if (isSpinning || spinsRemaining <= 0) return;
        
        isSpinning = true;
        spinBtn.disabled = true;

        try {
          // Call API
          const response = await fetch('/api/wheel/spin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId })
          });

          const result = await response.json();

          if (!result.success) {
            alert(result.error || 'Ошибка при вращении');
            isSpinning = false;
            spinBtn.disabled = spinsRemaining <= 0;
            return;
          }

          // Calculate rotation
          const sectorAngle = 360 / prizes.length;
          const targetSector = result.prizeIndex;
          
          // Spin multiple times + land on target sector
          const spins = 5; // Number of full rotations
          const targetAngle = 360 - (targetSector * sectorAngle) - (sectorAngle / 2);
          const totalRotation = currentRotation + (360 * spins) + targetAngle - (currentRotation % 360);
          
          currentRotation = totalRotation;
          wheel.style.transform = `rotate(${totalRotation}deg)`;

          // Wait for animation
          setTimeout(() => {
            // Update UI
            spinsRemaining = result.spinsRemaining;
            spinsRemainingEl.textContent = spinsRemaining;
            balanceValueEl.textContent = result.newBalance;
            
            // Update timer if needed
            if (result.nextSpinAvailable) {
              nextSpinAvailable = new Date(result.nextSpinAvailable);
              updateTimer();
            }

            // Show prize popup
            showPrize(result.prize);
            
            isSpinning = false;
            spinBtn.disabled = spinsRemaining <= 0;
          }, 4000);

        } catch (error) {
          console.error('Spin error:', error);
          alert('Ошибка сети');
          isSpinning = false;
          spinBtn.disabled = spinsRemaining <= 0;
        }
      }

      // Show prize popup
      function showPrize(prize) {
        prizeAmount.textContent = '+' + prize.value;
        prizeAmount.className = 'prize-amount' + (prize.value === 5000 ? ' jackpot' : '');
        prizePopup.classList.add('show');
        
        if (prize.value === 5000) {
          createConfetti();
        }
      }

      // Create confetti effect
      function createConfetti() {
        const colors = ['#ff4081', '#ffd700', '#7cfc00', '#4ecdc4', '#ff6b6b'];
        
        for (let i = 0; i < 100; i++) {
          const confetti = document.createElement('div');
          confetti.className = 'confetti-piece';
          confetti.style.left = Math.random() * 100 + 'vw';
          confetti.style.top = '-10px';
          confetti.style.background = colors[Math.floor(Math.random() * colors.length)];
          confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
          confetti.style.width = (Math.random() * 10 + 5) + 'px';
          confetti.style.height = confetti.style.width;
          
          document.body.appendChild(confetti);
          
          // Animate
          const animation = confetti.animate([
            { 
              transform: 'translateY(0) rotate(0deg)', 
              opacity: 1 
            },
            { 
              transform: `translateY(100vh) rotate(${Math.random() * 720}deg)`, 
              opacity: 0 
            }
          ], {
            duration: Math.random() * 2000 + 2000,
            easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
          });
          
          animation.onfinish = () => confetti.remove();
        }
      }

      // Update countdown timer
      function updateTimer() {
        if (!nextSpinAvailable || spinsRemaining >= 3) {
          timerEl.style.display = 'none';
          timerLabelEl.style.display = 'none';
          return;
        }

        const now = new Date();
        const diff = nextSpinAvailable - now;

        if (diff <= 0) {
          // Refresh status
          location.reload();
          return;
        }

        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);

        timerEl.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        timerEl.style.display = 'block';
        timerLabelEl.style.display = 'block';
      }

      // Event listeners
      spinBtn.addEventListener('click', spin);
      prizeClose.addEventListener('click', () => {
        prizePopup.classList.remove('show');
      });

      // Initialize
      createStars();
      createWheel();
      updateTimer();
      setInterval(updateTimer, 1000);
    </script>
  </body>
</html>
